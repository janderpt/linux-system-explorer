# Local experimental packaging/test tools. Not a Flathub manifest or submission.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    flatpak flatpak-builder ca-certificates git python3 appstream desktop-file-utils \
    dbus-x11 xdg-dbus-proxy xvfb xauth curl librsvg2-common \
    build-essential meson ninja-build pkg-config libglib2.0-dev \
    && rm -rf /var/lib/apt/lists/*
# Exercise the distribution's proxy, rather than masking compatibility bugs
# with a manually built replacement. Newer proxies can be tested separately.
ENV FLATPAK_DBUSPROXY=/usr/bin/xdg-dbus-proxy
WORKDIR /source
